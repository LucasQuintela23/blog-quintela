---
import "../styles/global.css";
import { defaultLang, languages, nonDefaultLangs, supportedLangs, type Lang, withLangPrefix } from "../i18n/config";
import { getUI } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = "Quintela",
  description = "Blog técnico focado em performance, legibilidade e tipografia editorial.",
  lang = defaultLang,
} = Astro.props;

const t = getUI(lang);

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const toHref = (path: string): string => {
  const normalizedPath = path.replace(/^\//, "");
  return normalizedPath ? `${baseUrl}${normalizedPath}` : baseUrl;
};

const localizedHref = (path: string) => toHref(withLangPrefix(path, lang));

const normalizeRoutePath = (path: string): string => {
  const withLeadingSlash = path.startsWith("/") ? path : `/${path}`;

  if (withLeadingSlash === "/") {
    return withLeadingSlash;
  }

  return withLeadingSlash.endsWith("/") ? withLeadingSlash : `${withLeadingSlash}/`;
};

const stripBasePath = (path: string): string => {
  const normalizedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;

  if (path === normalizedBase || path === `${normalizedBase}/`) {
    return "/";
  }

  if (path.startsWith(`${normalizedBase}/`)) {
    return path.slice(normalizedBase.length);
  }

  return path;
};

const removeLangPrefix = (path: string): string => {
  for (const candidateLang of nonDefaultLangs) {
    if (path === `/${candidateLang}` || path === `/${candidateLang}/`) {
      return "/";
    }

    if (path.startsWith(`/${candidateLang}/`)) {
      const withoutPrefix = path.slice(candidateLang.length + 1);
      return withoutPrefix.startsWith("/") ? withoutPrefix : `/${withoutPrefix}`;
    }
  }

  return path;
};

const currentRoute = normalizeRoutePath(removeLangPrefix(stripBasePath(Astro.url.pathname)));
const langSwitcherHref = (targetLang: Lang) => toHref(withLangPrefix(currentRoute, targetLang));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const persisted = localStorage.getItem("theme");
        const mode = ["light", "dark", "system"].includes(persisted ?? "") ? persisted : "system";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = mode === "dark" || (mode === "system" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>

  <body id="top">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="page-shell mx-auto flex min-h-screen w-full max-w-[1160px] flex-col px-4 sm:px-6">
      <header class="sticky top-0 z-20 border-b border-border/80 bg-bg/85 py-5 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
        <div class="flex items-center justify-between">
          <a href={localizedHref("/")} class="text-xl font-semibold tracking-tight text-ink">{t.siteName}</a>

          <nav class="flex items-center gap-4 text-xs uppercase tracking-[0.1em] text-muted sm:text-sm sm:normal-case sm:tracking-normal">
            <a href={localizedHref("/")} class="nav-link transition">{t.nav.posts}</a>
            <a href={localizedHref("/sobre/")} class="nav-link transition">{t.nav.about}</a>
            <div class="inline-flex items-center gap-1 rounded-full border border-border bg-surface/70 px-1 py-1" aria-label={t.nav.languageLabel}>
              {
                supportedLangs.map((availableLang) => (
                  <a
                    href={langSwitcherHref(availableLang)}
                    class:list={[
                      "rounded-full px-2 py-1 text-[0.62rem] font-semibold tracking-[0.08em] transition",
                      availableLang === lang
                        ? "bg-accent/20 text-ink"
                        : "text-muted hover:bg-border/25 hover:text-ink",
                    ]}
                    aria-label={`${t.nav.languageLabel}: ${availableLang.toUpperCase()}`}
                  >
                    {languages[availableLang]}
                  </a>
                ))
              }
            </div>
            <a
              href="https://github.com/LucasQuintela23"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface/70 text-muted transition hover:border-accent/50 hover:text-ink"
              aria-label={t.nav.githubLabel}
              title="GitHub"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2C6.48 2 2 6.58 2 12.22c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.5 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.22-3.37-1.22-.46-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.7.12 2.5.35 1.9-1.32 2.74-1.05 2.74-1.05.56 1.42.21 2.46.11 2.72.64.72 1.02 1.63 1.02 2.75 0 3.92-2.34 4.79-4.57 5.04.36.31.68.93.68 1.88 0 1.35-.01 2.44-.01 2.77 0 .27.18.6.69.5A10.25 10.25 0 0 0 22 12.22C22 6.58 17.52 2 12 2z" />
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/lucasquintela23/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface/70 text-muted transition hover:border-accent/50 hover:text-ink"
              aria-label={t.nav.linkedinLabel}
              title="LinkedIn"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.03-1.85-3.03-1.86 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
              </svg>
            </a>
            <div class="relative">
              <button
                id="theme-toggle"
                type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface/70 text-muted transition hover:border-accent/50 hover:text-ink"
                aria-label={t.nav.openThemeMenu}
                aria-expanded="false"
                aria-controls="theme-menu"
                data-open-theme-label={t.nav.openThemeMenu}
                data-theme-light={t.nav.light}
                data-theme-dark={t.nav.dark}
                data-theme-system={t.nav.system}
              >
                <span id="theme-icon-sun" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2.4M12 19.6V22M4.93 4.93l1.7 1.7M17.37 17.37l1.7 1.7M2 12h2.4M19.6 12H22M4.93 19.07l1.7-1.7M17.37 6.63l1.7-1.7"></path>
                  </svg>
                </span>
                <span id="theme-icon-moon" class="hidden" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.35 14.9A9 9 0 1 1 9.1 3.65a7 7 0 0 0 11.25 11.25z"></path>
                  </svg>
                </span>
              </button>

              <div
                id="theme-menu"
                class="absolute right-0 mt-2 hidden w-36 rounded-xl border border-border bg-surface p-1.5 text-[0.95rem] normal-case tracking-normal text-ink shadow-lg"
                role="menu"
                aria-label={t.nav.themeMenuLabel}
              >
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="light" role="menuitemradio">
                  <span>{t.nav.light}</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="dark" role="menuitemradio">
                  <span>{t.nav.dark}</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="system" role="menuitemradio">
                  <span>{t.nav.system}</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
              </div>
            </div>
          </nav>
        </div>
      </header>

      <main class="flex-1 py-10 sm:py-12">
        <slot />
      </main>

      <footer class="border-t border-border py-7 text-sm text-muted">
        <p>{t.footer.rights}</p>
      </footer>
    </div>

    <script is:inline>
      const button = document.getElementById("theme-toggle");
      const menu = document.getElementById("theme-menu");
      const sunIcon = document.getElementById("theme-icon-sun");
      const moonIcon = document.getElementById("theme-icon-moon");
      const options = Array.from(document.querySelectorAll("[data-theme-option]"));
      const root = document.documentElement;
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const openThemeLabel = button?.getAttribute("data-open-theme-label") ?? "Open theme menu";
      const lightThemeLabel = button?.getAttribute("data-theme-light") ?? "Light";
      const darkThemeLabel = button?.getAttribute("data-theme-dark") ?? "Dark";
      const systemThemeLabel = button?.getAttribute("data-theme-system") ?? "System";

      const getStoredMode = () => {
        const mode = localStorage.getItem("theme");
        return mode === "light" || mode === "dark" || mode === "system" ? mode : "system";
      };

      const applyTheme = (mode) => {
        const isDark = mode === "dark" || (mode === "system" && mediaQuery.matches);
        root.classList.toggle("dark", isDark);
      };

      const closeMenu = () => {
        if (!button || !menu) return;
        menu.classList.add("hidden");
        button.setAttribute("aria-expanded", "false");
      };

      const openMenu = () => {
        if (!button || !menu) return;
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
      };

      const setThemeUI = (mode) => {
        if (!button) return;
        const dark = root.classList.contains("dark");
        button.setAttribute("aria-label", openThemeLabel);
        button.setAttribute("title", mode === "system" ? systemThemeLabel : dark ? darkThemeLabel : lightThemeLabel);
        sunIcon?.classList.toggle("hidden", dark);
        moonIcon?.classList.toggle("hidden", !dark);

        options.forEach((option) => {
          const value = option.getAttribute("data-theme-option");
          const selected = value === mode;
          option.setAttribute("aria-checked", selected ? "true" : "false");
          option.querySelector(".theme-check")?.classList.toggle("hidden", !selected);
        });
      };

      const setThemeMode = (mode) => {
        localStorage.setItem("theme", mode);
        applyTheme(mode);
        setThemeUI(mode);
      };

      const initialMode = getStoredMode();
      applyTheme(initialMode);
      setThemeUI(initialMode);

      button?.addEventListener("click", () => {
        if (!menu || menu.classList.contains("hidden")) {
          openMenu();
          return;
        }
        closeMenu();
      });

      options.forEach((option) => {
        option.addEventListener("click", () => {
          const mode = option.getAttribute("data-theme-option");
          if (!mode) return;
          setThemeMode(mode);
          closeMenu();
        });
      });

      document.addEventListener("click", (event) => {
        if (!menu || !button) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (menu.contains(target) || button.contains(target)) return;
        closeMenu();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      mediaQuery.addEventListener("change", () => {
        const mode = getStoredMode();
        if (mode !== "system") return;
        applyTheme(mode);
        setThemeUI(mode);
      });

    </script>
  </body>
</html>
