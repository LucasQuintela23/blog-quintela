---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quintela",
  description = "Blog técnico focado em performance, legibilidade e tipografia editorial.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const persisted = localStorage.getItem("theme");
        const mode = ["light", "dark", "system"].includes(persisted ?? "") ? persisted : "system";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = mode === "dark" || (mode === "system" && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
  </head>

  <body id="top">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="page-shell mx-auto flex min-h-screen w-full max-w-[1160px] flex-col px-4 sm:px-6">
      <header class="sticky top-0 z-20 border-b border-border/80 bg-bg/85 py-5 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
        <div class="flex items-center justify-between">
          <a href={baseUrl} class="text-xl font-semibold tracking-tight text-ink">Quintela</a>

          <nav class="flex items-center gap-4 text-xs uppercase tracking-[0.1em] text-muted sm:text-sm sm:normal-case sm:tracking-normal">
            <a href={baseUrl} class="nav-link transition">Artigos</a>
            <a href={`${baseUrl}sobre/`} class="nav-link transition">Sobre</a>
            <div class="relative">
              <button
                id="theme-toggle"
                type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface/70 text-muted transition hover:border-accent/50 hover:text-ink"
                aria-label="Abrir menu de tema"
                aria-expanded="false"
                aria-controls="theme-menu"
              >
                <span id="theme-icon-sun" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2.4M12 19.6V22M4.93 4.93l1.7 1.7M17.37 17.37l1.7 1.7M2 12h2.4M19.6 12H22M4.93 19.07l1.7-1.7M17.37 6.63l1.7-1.7"></path>
                  </svg>
                </span>
                <span id="theme-icon-moon" class="hidden" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.35 14.9A9 9 0 1 1 9.1 3.65a7 7 0 0 0 11.25 11.25z"></path>
                  </svg>
                </span>
              </button>

              <div
                id="theme-menu"
                class="absolute right-0 mt-2 hidden w-36 rounded-xl border border-border bg-surface p-1.5 text-[0.95rem] normal-case tracking-normal text-ink shadow-lg"
                role="menu"
                aria-label="Selecionar tema"
              >
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="light" role="menuitemradio">
                  <span>Claro</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="dark" role="menuitemradio">
                  <span>Escuro</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
                <button type="button" class="theme-option flex w-full items-center justify-between rounded-lg px-3 py-2 text-left transition hover:bg-border/25" data-theme-option="system" role="menuitemradio">
                  <span>Sistema</span>
                  <span class="theme-check hidden" aria-hidden="true">✓</span>
                </button>
              </div>
            </div>
          </nav>
        </div>
      </header>

      <main class="flex-1 py-10 sm:py-12">
        <slot />
      </main>

      <footer class="border-t border-border py-7 text-sm text-muted">
        <p>Documentando pesquisas, fundamentos e boas práticas em Engenharia de Software e qualidade.</p>
        <p class="mt-2">Todos os direitos reservados - Lucas Quintela</p>
      </footer>
    </div>

    <script is:inline>
      const button = document.getElementById("theme-toggle");
      const menu = document.getElementById("theme-menu");
      const sunIcon = document.getElementById("theme-icon-sun");
      const moonIcon = document.getElementById("theme-icon-moon");
      const options = Array.from(document.querySelectorAll("[data-theme-option]"));
      const root = document.documentElement;
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

      const getStoredMode = () => {
        const mode = localStorage.getItem("theme");
        return mode === "light" || mode === "dark" || mode === "system" ? mode : "system";
      };

      const applyTheme = (mode) => {
        const isDark = mode === "dark" || (mode === "system" && mediaQuery.matches);
        root.classList.toggle("dark", isDark);
      };

      const closeMenu = () => {
        if (!button || !menu) return;
        menu.classList.add("hidden");
        button.setAttribute("aria-expanded", "false");
      };

      const openMenu = () => {
        if (!button || !menu) return;
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
      };

      const setThemeUI = (mode) => {
        if (!button) return;
        const dark = root.classList.contains("dark");
        button.setAttribute("aria-label", "Abrir menu de tema");
        button.setAttribute("title", mode === "system" ? "Tema: Sistema" : dark ? "Tema: Escuro" : "Tema: Claro");
        sunIcon?.classList.toggle("hidden", dark);
        moonIcon?.classList.toggle("hidden", !dark);

        options.forEach((option) => {
          const value = option.getAttribute("data-theme-option");
          const selected = value === mode;
          option.setAttribute("aria-checked", selected ? "true" : "false");
          option.querySelector(".theme-check")?.classList.toggle("hidden", !selected);
        });
      };

      const setThemeMode = (mode) => {
        localStorage.setItem("theme", mode);
        applyTheme(mode);
        setThemeUI(mode);
      };

      const initialMode = getStoredMode();
      applyTheme(initialMode);
      setThemeUI(initialMode);

      button?.addEventListener("click", () => {
        if (!menu || menu.classList.contains("hidden")) {
          openMenu();
          return;
        }
        closeMenu();
      });

      options.forEach((option) => {
        option.addEventListener("click", () => {
          const mode = option.getAttribute("data-theme-option");
          if (!mode) return;
          setThemeMode(mode);
          closeMenu();
        });
      });

      document.addEventListener("click", (event) => {
        if (!menu || !button) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (menu.contains(target) || button.contains(target)) return;
        closeMenu();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      mediaQuery.addEventListener("change", () => {
        const mode = getStoredMode();
        if (mode !== "system") return;
        applyTheme(mode);
        setThemeUI(mode);
      });

    </script>
  </body>
</html>
