---
import HomePage from "../_includes/pages/HomePage.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<HomePage />

<script is:inline define:vars={{ baseUrl }}>
	(() => {
		const basePath = baseUrl;
		const path = window.location.pathname;

		const rootWithSlash = basePath;
		const rootWithoutSlash = basePath.endsWith("/") ? basePath.slice(0, -1) : basePath;
		const isRootAccess = path === rootWithSlash || path === rootWithoutSlash;

		if (!isRootAccess) return;
		if (sessionStorage.getItem("locale-redirect-done") === "1") return;

		const preferred = [...(navigator.languages ?? []), navigator.language]
			.filter(Boolean)
			.map((locale) => locale.toLowerCase());

		const target = preferred.find((locale) => locale.startsWith("en") || locale.startsWith("es"));

		sessionStorage.setItem("locale-redirect-done", "1");

		if (!target) return;

		const lang = target.startsWith("en") ? "en" : "es";
		window.location.replace(`${basePath}${lang}/`);
	})();
</script>
